{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["deployment_id", "environment", "service", "metric", "comparison_status", "classification", "direction", "confidence", "causality_claimed", "investigation_key", "comparison_key", "classification_key", "before_value", "after_value", "absolute_delta", "relative_delta", "before_sample_count", "after_sample_count", "facts", "limitations"],
  "properties": {
    "deployment_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "environment": {"type": "string"},
    "service": {"type": "string"},
    "metric": {"type": "string"},
    "comparison_status": {"type": "string", "enum": ["AVAILABLE", "UNKNOWN"]},
    "classification": {"type": "string", "enum": ["CANDIDATE", "NO_SIGNAL", "UNKNOWN"]},
    "direction": {"type": "string", "enum": ["INCREASE", "DECREASE", "NONE", "UNKNOWN"]},
    "confidence": {"type": "string", "enum": ["LOW", "UNKNOWN"]},
    "causality_claimed": {"type": "boolean"},
    "investigation_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "comparison_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "classification_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "before_value": {"type": ["number", "null"]},
    "after_value": {"type": ["number", "null"]},
    "absolute_delta": {"type": ["number", "null"]},
    "relative_delta": {"type": ["number", "null"]},
    "before_sample_count": {"type": ["integer", "null"]},
    "after_sample_count": {"type": ["integer", "null"]},
    "facts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
